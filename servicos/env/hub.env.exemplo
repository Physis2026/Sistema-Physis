# Physis Hub no servidor. Variáveis fixas da rede (endereço, proxy, banco) ficam no docker-compose.yml.
PHYSIS_URL_PUBLICA=https://hub.exemplo.com.br
PHYSIS_ACEITAR_SEM_CHAVE=0
PHYSIS_SUPORTE_EMAIL=
# "Permitir suporte" (docs/SUPORTE_REMOTO.md): CIDR da VPN e contas da equipe Physis. D23: contas VAZIAS por enquanto
# (ninguém entra com o código); a conta do Eric fica para a fase 2.
PHYSIS_SUPORTE_REDES=
PHYSIS_SUPORTE_CONTAS=
PHYSIS_SMTP_HOST=
PHYSIS_SMTP_PORTA=587
PHYSIS_SMTP_USUARIO=
PHYSIS_SMTP_SENHA=
PHYSIS_SMTP_REMETENTE=
# gerada por preparar.sh e gravada também no arquivo de senhas do Mosquitto
PHYSIS_MQTT_SENHA=
PHYSIS_MQTT_NOS=
# motores de cálculo e IA (opcionais; o hub funciona sem eles)
PHYSIS_CALC_CHAVE=
PHYSIS_DOC_CHAVE=
# intercâmbio com plataformas parceiras (docs/INTERCAMBIO.md): a chave fica no arquivo, não aqui
PHYSIS_INTERCAMBIO_ID=
PHYSIS_INTERCAMBIO_CHAVES=
PHYSIS_IA_MODELO=
PHYSIS_IA_CHAVE=
