+QUEM = {"vencimentos": "Direção / contador / advogado", "fatos": "Direção", "kit": "Direção", "atrasos": "Direção", "documentos": "Equipe (dono do documento)", "editais": "Instituto Physis", "acervo": "Equipe InovaSTEM",
