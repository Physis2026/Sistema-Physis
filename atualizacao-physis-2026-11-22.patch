-    invest:(g("custo", 0) && g("tarifa", 0) && aep > 0) ? invest(g("custo", 0), aep / 12 * g("tarifa", 0), g("vida", 20), g("taxa", 10), g("infl", 4)) : null, avisos }; }
+    invest:inv, avisos }; }
 
