+        tipos = dict(mv.db.execute("SELECT tipo, COUNT(*) FROM mv_parceria GROUP BY tipo").fetchall())
+        self.assertEqual(tipos.get("fabricante"), 1)
+        self.assertGreaterEqual(tipos.get("estagio", 0), 1)
