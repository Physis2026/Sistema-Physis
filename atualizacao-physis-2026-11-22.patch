+    diz(f"       Documentos do OneDrive: {mv_bots.DOCS}" + ("" if mv_bots.DOCS.is_dir() else "  (NÃO ENCONTRADA: guia, PHYSIS_DOCS)"))
+    for p in mv_bots.pastas_documentos():
