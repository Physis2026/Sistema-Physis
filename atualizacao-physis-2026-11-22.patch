+# ---- acervo → trilhas (InovaSTEM) -----------------------------------------------------------------------------------
+TIPOS_ACERVO = {".pdf", ".odt", ".docx", ".odp", ".pptx", ".ods", ".xlsx", ".md", ".txt", ".mp4", ".html"}
